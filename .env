PHOENIX_COLLECTOR_ENDPOINT=https://phoenix.example.com:6006/
PHOENIX_OTLP_ENDPOINT=https://phoenix.example.com:6006/v1/traces
ARIZE_ENDPOINT=https://otlp.arize.com/v1
ALLOW_INSECURE_CONNECTION=true
USE_AX_MODE=false
ONLINE_SAMPLE_RATIO=0.1
SAMPLE_TRACKING_ENABLED=true
OPENAI_API_KEY=your_openai_key_here
APIGEE_KEY=your_apigee_key_here
ARIZE_SPACE_KEY=your_arize_space_key
ARIZE_API_KEY=your_arize_api_key
CUSTOM_HEADERS_JSON={"X-Custom": "value"}
REFRESH_INTERVAL_SECONDS=3600
CUSTOM_SSL_CERT_FILE=/path/to/cert.pem
APIGEE_ENDPOINT=https://your-apigee-endpoint/oauth/token
APIGEE_CLIENT_ID=your_client_id
APIGEE_CLIENT_SECRET=your_client_secret
APIGEE_REFRESH_INTERVAL=3600